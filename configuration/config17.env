# Component versions
export PG_VERSION=17.8
export PG_MAJOR_VERSION=17
export PGEDGE_SPOCK50_17_VERSION=5.0.5
export PGEDGE_LOLOR_17_VERSION=1.2.2
export PGEDGE_SNOWFLAKE_17_VERSION=2.4
export PGEDGE_PGAUDIT_17_VERSION=17.8
export PGEDGE_PGVECTOR_17_VERSION=0.8.1
export PGEDGE_POSTGIS35_17_VERSION=3.5.4
export PGEDGE_ENTERPRISE_ALL_17_VERSION=17.8
export PGEDGE_ENTERPRISE_POSTGRES_17_VERSION=17.8
export PGEDGE_PLDEBUGGER_17_VERSION=1.9
export PGEDGE_POSTGRESQL17_SERVER_VERSION=17.8
export PGEDGE_POSTGRESQL17_PLPERL_VERSION=17.8
export PGEDGE_POSTGRESQL17_PLTCL_VERSION=17.8
export PGEDGE_POSTGRESQL17_PLPYTHON3_VERSION=17.8
export PGEDGE_PGBOUNCER_VERSION=1.25.1
export PGEDGE_PGBACKREST_VERSION=2.56.0
export PGEDGE_PGADMIN4_VERSION=9.8
export PGEDGE_SYSTEM_STATS_VERSION=3.2.1

# Configuration parameters for Zero Downtime Integration Testing
export ENTERPRISE_ALL_PACKAGE=pgedge-enterprise-postgres_17
export DEB_ENTERPRISE_ALL_PACKAGE=pgedge-enterprise-postgres-17
export ALL_META_PACKAGE=pgedge-enterprise-postgres_17
export NO_OF_NODES=2
export BASE_PORT=5431


# Repository (release | staging | daily)
export REPO=release
export UPGRADE=false # Possible values true | false
export UPGRADE_REPO=staging

# Configuration paratmers for pgbouncer
export PGBOUNCER_PACKAGE=pgedge-pgbouncer
export PGBOUNCER_PORT=6432
export PGBOUNCER_CONFIG_DIR=/etc/pgbouncer
export PGBOUNCER_USER=pgbouncer
export DEB_PGBOUNCER_BIN=/usr/sbin
export RHEL_PGBOUNCER_BIN=/usr/bin
export PGBOUNCER_STRIPPED_BIN=pgbouncer

# Configuration paratmers for SnowFlake
export SNOWFLAKE_PACKAGE=pgedge-snowflake_17
export DEB_SNOWFLAKE_PACKAGE=pgedge-postgresql-17-snowflake
export SNOWFLAKE_NODE=1
export RHEL_SNOWFLAKE_LIB=/usr/pgsql-17/lib/
export DEB_SNOWFLAKE_LIB=/usr/lib/postgresql/17/lib/
export SNOWFLAKE_STRIPPED_LIB=snowflake.so

# Configuration paratmers for SYSTEM_STATS
export SYSTEM_STATS_PACKAGE=pgedge-system_stats_17
export DEB_SYSTEM_STATS_PACKAGE=pgedge-postgresql-17-system-stats
export RHEL_SYSTEM_STATS_LIB=/usr/pgsql-17/lib/
export DEB_SYSTEM_STATS_LIB=/usr/lib/postgresql/17/lib/
export SYSTEM_STATS_STRIPPED_LIB=system_stats.so

# Configuration paratmers for LOLOR
export LOLOR_PACKAGE=pgedge-lolor_17
export DEB_LOLOR_PACKAGE=pgedge-postgresql-17-lolor
export RHEL_LOLOR_LIB=/usr/pgsql-17/lib/
export DEB_LOLOR_LIB=/usr/lib/postgresql/17/lib/
export LOLOR_STRIPPED_LIB=lolor.so

# Configuration paratmers for PostGIS
export POSTGIS_PACKAGE=pgedge-postgis35_17
export DEB_POSTGIS_PACKAGE=pgedge-postgresql-17-postgis-3
export POSTGIS_EXTENSIONS=postgis,postgis_topology,postgis_raster,postgis_sfcgal,fuzzystrmatch,postgis_tiger_geocoder,address_standardizer,address_standardizer_data_us
export POSTGIS_MAJOR_VERSION=3
export POSTGIS_LIB=/usr/pgsql-17/lib/
export POSTGIS_STRIPPED_LIB=postgis-3.so,address_standardizer-3.so,postgis_raster-3.so,postgis_topology-3.so,postgis_sfcgal-3.so

# Configuration paratmers for Server
export SERVER_PACKAGE=pgedge-postgresql17-server,pgedge-postgresql17-contrib
export DEB_SERVER_PACKAGE=pgedge-postgresql-17
export SERVER_INTEGRATION_PACKAGES=pgedge-snowflake_17,pgedge-postgis35_17,pgedge-lolor_17,pgedge-spock50_17,pgedge-pldebugger_17,pgedge-pgaudit_17
export DEB_SERVER_INTEGRATION_PACKAGES=pgedge-postgresql-17-snowflake,pgedge-postgresql-17-postgis-3,pgedge-postgresql-17-lolor,pgedge-postgresql-17-spock50,pgedge-postgresql-17-pldebugger,pgedge-postgresql-17-pgaudit
export SERVER_INTEGRATION_EXTENSIONS=snowflake,postgis,postgis_topology,postgis_raster,postgis_sfcgal,fuzzystrmatch,postgis_tiger_geocoder,address_standardizer,address_standardizer_data_us,spock,lolor
export SERVER_INTEGRATION_TESTING=false

# Configuration paratmers for MCP and NLA
export MCP_COMPONENTS=pgedge-postgres-mcp,pgedge-postgres-mcp-kb,pgedge-nla-cli,pgedge-nla-web
export DEB_MCP_COMPONENTS=pgedge-postgres-mcp,pgedge-postgres-mcp-kb,pgedge-nla-cli,pgedge-nla-web


