# Container details (comma separated if multiple)
#CONTAINERS=auto-rocky9-arm,auto-rocky10-arm,auto-oel9-amd
#CONTAINERS=auto-rocky10-arm,auto-alma9-arm,auto-alma10-arm,auto-oel9-arm,auto-oel10-arm,my-rocky9-amd,auto-alma9-amd,auto-oel9-amd
export CONTAINERS=auto-rocky9-arm
#export DEB_CONTAINERS=auto-debian12-arm,auto-debian13-arm,auto-debian13-amd,auto-ubuntu2204-arm,auto-ubuntu2404-arm
export DEB_CONTAINERS=auto-debian11

#ubuntu-systemd-custom
# Component versions
export PG_VERSION=16.11
export PG_MAJOR_VERSION=16
export PGEDGE_SPOCK50_16_VERSION=5.0.4
export PGEDGE_LOLOR_16_VERSION=1.2.2
export PGEDGE_SNOWFLAKE_16_VERSION=2.4
export PGEDGE_PGAUDIT_16_VERSION=16.1
export PGEDGE_PGVECTOR_16_VERSION=0.8.1
export PGEDGE_POSTGIS35_16_VERSION=3.5.3
export PGEDGE_ENTERPRISE_ALL_16_VERSION=16.11
export PGEDGE_ENTERPRISE_POSTGRES_16_VERSION=16.11
export PGEDGE_PLDEBUGGER_16_VERSION=1.9
export PGEDGE_POSTGRESQL16_SERVER_VERSION=16.11
export PGEDGE_POSTGRESQL16_PLPERL_VERSION=16.11
export PGEDGE_POSTGRESQL16_PLTCL_VERSION=16.11
export PGEDGE_POSTGRESQL16_PLPYTHON3_VERSION=16.11
export PGEDGE_PGBOUNCER_VERSION=1.25.1
export PGEDGE_PGBACKREST_VERSION=2.56.0
export PGEDGE_PGADMIN4_VERSION=9.8

# Configuration paratmers for pgbouncer
export PGBOUNCER_PACKAGE=pgedge-pgbouncer
export PGBOUNCER_PORT=6432
export PGBOUNCER_CONFIG_DIR=/etc/pgbouncer
export PGBOUNCER_USER=pgbouncer
export DEB_PGBOUNCER_USER=postgres
export DEB_PGBOUNCER_BIN=/usr/sbin
export RHEL_PGBOUNCER_BIN=/usr/bin


# Configuration paratmers for SnowFlake
export SNOWFLAKE_PACKAGE=pgedge-snowflake_16
export DEB_SNOWFLAKE_PACKAGE=pgedge-postgresql-16-snowflake
export SNOWFLAKE_NODE=1
# Configuration paratmers for SnowFlake
export SERVER_PACKAGE=pgedge-postgresql16-server
export DEB_SERVER_PACKAGE=pgedge-postgresql-16
# Repository (release | staging | daily)
export REPO=staging
export UPGRADE=false # Possible values true | false
export UPGRADE_REPO=staging

# Components (comma separated)
# RHEL Components (comma separated)
export SERVER_COMPONENTS=pgedge-enterprise-all_16,pgedge-pldebugger_16,pgedge-*16*llvm*
#export SERVER_COMPONENTS=pgedge-lolor_16,pgedge-spock50_16,pgedge-snowflake_16,pgedge-pgaudit_16,pgedge-pldebugger_16
# export SERVER_COMPONENTS=pgedge-lolor_16,pgedge-spock50_16,pgedge-snowflake_16,pgedge-pgaudit_16,pgedge-pgvector_16,pgedge-postgis35_16,pgedge-postgresql16-server,pgedge-postgresql16-contrib,pgedge-pldebugger_16,pgedge-pgbouncer,pgedge-pgbackrest,pgedge-pgadmin4
# export SERVER_COMPONENTS=pgedge-enterprise-all_16,pgedge-enterprise-postgres_16,pgedge-postgresql16-server,pgedge-postgresql16-contrib,pgedge-pldebugger_16

# Components name for Ubuntu and Debian packages (comma seperated)
#export DEB_SERVER_COMPONENTS=pgedge-postgresql-16-pldebugger,pgedge-postgresql-16-pgvector,pgedge-postgresql-16-pgaudit,pgedge-postgresql-16-lolor,pgedge-postgresql-16-snowflake,pgedge-postgresql-16-spock50
#export DEB_SERVER_COMPONENTS=pgedge-postgresql-16,pgedge-postgresql,pgedge-postgresql-plperl-16,pgedge-postgresql-plpython3-16,pgedge-postgresql-pltcl-16,pgedge-postgresql-16-pldebugger,pgedge-postgresql-16-postgis-3,pgedge-postgresql-16-pgvector,pgedge-postgresql-16-pgaudit,pgedge-postgresql-16-lolor,pgedge-postgresql-16-snowflake,pgedge-postgresql-16-spock50,pgedge-pgbackrest,pgedge-pgadmin4,pgedge-pgbouncer
export DEB_SERVER_COMPONENTS=pgedge-enterprise-all-16,pgedge-postgresql-plperl-16,pgedge-postgresql-plpython3-16,pgedge-postgresql-pltcl-16,pgedge-postgresql-16-pldebugger

# Whether to test extensions
export TEST_EXTENSIONS=true
# Base extensions (contrib + builtins)
### All extensions
export EXTENSIONS=snowflake,spock,lolor,pldbgapi,vector,bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp,postgis,postgis_topology,postgis_raster,postgis_sfcgal,fuzzystrmatch,postgis_tiger_geocoder,address_standardizer,address_standardizer_data_us
#EXTENSIONS=snowflake,spock,lolor,pldbgapi,vector,bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp
## only server extensions
#EXTENSIONS=bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp

# PL packages (comma separated)
export PL_PACKAGES=pgedge-postgresql16-plperl,pgedge-postgresql16-pltcl,pgedge-postgresql16-plpython3

# PL extensions (comma separated)
export PL_EXTENSIONS=plperl,pltcl,plpython3u

# Cluster configuration
export PG_USER=postgres
export PG_PORT=5432
## PG BIN for RHEL
export PG_BIN_PATH=/usr/pgsql-16/bin
## PG BIN for DEB
export DEB_PG_BIN_PATH=/usr/lib/postgresql/16/bin/
export DEB_PG_PATH=/usr/lib/postgresql/16/
export DEB_PG_SHARE_PATH=/usr/share/postgresql/16/
export PG_DATA_DIR=/tmp/n1


