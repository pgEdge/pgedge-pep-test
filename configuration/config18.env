export PGEDGE_NLA_CLI_VERSION=1.0.0-beta3
export PGEDGE_POSTGRES_MCP_KB_VERSION=1.0.0-beta3
export PGEDGE_NLA_WEB_VERSION=1.0.0-beta3


# Repository (release | staging | daily)
export REPO=staging
export UPGRADE=false # Possible values true | false
export UPGRADE_REPO=staging

# Configuration parameters for Zero Downtime Integration Testing
export ENTERPRISE_ALL_PACKAGE=pgedge-enterprise-all_18
export DEB_ENTERPRISE_ALL_PACKAGE=pgedge-enterprise-all-18
export ALL_META_PACKAGE=pgedge-enterprise-all_18
export NO_OF_NODES=2
export BASE_PORT=5431

# Configuration paratmers for pgbouncer
export PGBOUNCER_PACKAGE=pgedge-pgbouncer
export PGBOUNCER_PORT=6432
export PGBOUNCER_CONFIG_DIR=/etc/pgbouncer
export PGBOUNCER_USER=pgbouncer
export DEB_PGBOUNCER_BIN=/usr/sbin
export RHEL_PGBOUNCER_BIN=/usr/bin
export PGBOUNCER_STRIPPED_BIN=pgbouncer



# Configuration paratmers for SnowFlake
export SNOWFLAKE_PACKAGE=pgedge-snowflake_18
export DEB_SNOWFLAKE_PACKAGE=pgedge-postgresql-18-snowflake
export SNOWFLAKE_NODE=1
export RHEL_SNOWFLAKE_LIB=/usr/pgsql-18/lib/
export DEB_SNOWFLAKE_LIB=/usr/lib/postgresql/18/lib/
export SNOWFLAKE_STRIPPED_LIB=snowflake.so

# Configuration paratmers for SYSTEM_STATS
export SYSTEM_STATS_PACKAGE=pgedge-system_stats_18
export DEB_SYSTEM_STATS_PACKAGE=pgedge-postgresql-18-system-stats
export RHEL_SYSTEM_STATS_LIB=/usr/pgsql-16/lib/
export DEB_SYSTEM_STATS_LIB=/usr/lib/postgresql/16/lib/
export SYSTEM_STATS_STRIPPED_LIB=system_stats.so

# Configuration paratmers for LOLOR
export LOLOR_PACKAGE=pgedge-lolor_18
export DEB_LOLOR_PACKAGE=pgedge-postgresql-18-lolor
export RHEL_LOLOR_LIB=/usr/pgsql-18/lib/
export DEB_LOLOR_LIB=/usr/lib/postgresql/18/lib/
export LOLOR_STRIPPED_LIB=lolor.so

# Configuration paratmers for PostGIS
export POSTGIS_PACKAGE=pgedge-postgis35_18
export DEB_POSTGIS_PACKAGE=pgedge-postgresql-18-postgis-3
export POSTGIS_EXTENSIONS=postgis,postgis_topology,postgis_raster,postgis_sfcgal,fuzzystrmatch,postgis_tiger_geocoder,address_standardizer,address_standardizer_data_us
export POSTGIS_MAJOR_VERSION=3
export POSTGIS_LIB=/usr/pgsql-18/lib/
export POSTGIS_STRIPPED_LIB=postgis-3.so,address_standardizer-3.so,postgis_raster-3.so,postgis_topology-3.so,postgis_sfcgal-3.so


# Configuration paratmers for Server
export SERVER_PACKAGE=pgedge-postgresql18-server,pgedge-postgresql18-contrib
export DEB_SERVER_PACKAGE=pgedge-postgresql-18
export SERVER_INTEGRATION_PACKAGES=pgedge-snowflake_18,pgedge-postgis35_18,pgedge-lolor_18,pgedge-spock50_18,pgedge-pldebugger_18,pgedge-pgaudit_18
export DEB_SERVER_INTEGRATION_PACKAGES=pgedge-postgresql-18-snowflake,pgedge-postgresql-18-postgis-3,pgedge-postgresql-18-lolor,pgedge-postgresql-18-spock50,pgedge-postgresql-18-pldebugger,pgedge-postgresql-18-pgaudit
export SERVER_INTEGRATION_EXTENSIONS=snowflake,postgis,postgis_topology,postgis_raster,postgis_sfcgal,fuzzystrmatch,postgis_tiger_geocoder,address_standardizer,address_standardizer_data_us,spock,lolor
export SERVER_INTEGRATION_TESTING=false

# Configuration paratmers for MCP and NLA
export MCP_COMPONENTS=pgedge-postgres-mcp,pgedge-postgres-mcp-kb,pgedge-nla-cli,pgedge-nla-web
export DEB_MCP_COMPONENTS=pgedge-postgres-mcp,pgedge-postgres-mcp-kb,pgedge-nla-cli,pgedge-nla-web


# Configurtion parameters for ACE
export ACE_COMPONENTS=pgedge-ace
export DEB_ACE_COMPONENTS=pgedge-ace
export ACE_BIN=/usr/bin/ace
export ACE_NO_OF_CLUSTERS=3



# RHEL Components (comma separated)
export SERVER_COMPONENTS=pgedge-enterprise-all_18,pgedge-pldebugger_18,pgedge-*18*llvm*
