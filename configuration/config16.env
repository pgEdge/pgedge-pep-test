# Package version
export PGEDGE_CONTROL_PLANE_VERSION=0.10.1

# ============================================================
# Configuration parameters for Coldfront
# ============================================================
# Coldfront ships five packages: two coupled to the PostgreSQL major
# version (the coldfront and pg_duckdb extensions) and three decoupled
# (the coldfront binaries, the bundled DuckDB extensions, and lakekeeper).

# Coupled package name(s)
export COLDFRONT_PACKAGE=pgedge-coldfront_16
export DEB_COLDFRONT_PACKAGE=pgedge-postgresql-16-coldfront
export PG_DUCKDB_PACKAGE=pgedge-pg-duckdb_16
export DEB_PG_DUCKDB_PACKAGE=pgedge-postgresql-16-pg-duckdb

# Decoupled package name(s) — RHEL and DEB names are identical
export COLDFRONT_SERVER_PACKAGE=pgedge-coldfront
export COLDFRONT_DUCKDB_EXTENSIONS_PACKAGE=pgedge-coldfront-duckdb-extensions
export LAKEKEEPER_PACKAGE=pgedge-lakekeeper

# Full component package lists (drive the per-package parametrized tests)
export COLDFRONT_COMPONENTS=pgedge-coldfront_16,pgedge-pg-duckdb_16,pgedge-coldfront,pgedge-coldfront-duckdb-extensions,pgedge-lakekeeper
export DEB_COLDFRONT_COMPONENTS=pgedge-postgresql-16-coldfront,pgedge-postgresql-16-pg-duckdb,pgedge-coldfront,pgedge-coldfront-duckdb-extensions,pgedge-lakekeeper

# Binary paths
export COLDFRONT_SERVER_BINARIES=/usr/bin/archiver,/usr/bin/compactor,/usr/bin/partitioner
export LAKEKEEPER_BINARY=/usr/bin/lakekeeper

# PostgreSQL extensions
export COLDFRONT_EXTENSIONS=coldfront
export PG_DUCKDB_EXTENSIONS=pg_duckdb
# Extension versions reported by \dx — these track the extension's
# default_version (from the .control file), not the package version.
export COLDFRONT_EXTENSION_VERSION=1.0
export PG_DUCKDB_EXTENSION_VERSION=1.1.0

# Package versions
export PGEDGE_COLDFRONT_16_VERSION=1.0.0-beta2
export PGEDGE_PG_DUCKDB_16_VERSION=1.5.4-beta2
export PGEDGE_COLDFRONT_SERVER_VERSION=1.0.0-beta2
export PGEDGE_COLDFRONT_DUCKDB_EXTENSIONS_VERSION=1.5.4-beta2
# lakekeeper versions differ by packaging format (RPM '-beta2' vs DEB '~beta2')
export PGEDGE_LAKEKEEPER_VERSION=0.13.1-beta2
export PGEDGE_LAKEKEEPER_DEB_VERSION=0.13.1~beta2

# ============================================================
# Configuration parameters for SafeSession
# ============================================================

# Package name(s) — coupled component (tied to the PG major version)
export SAFESESSION_PACKAGE=pgedge-safesession_16
export DEB_SAFESESSION_PACKAGE=pgedge-postgresql-16-safesession

# Shared library (no standalone binary is shipped)
export RHEL_SAFESESSION_LIB=/usr/pgsql-16/lib/
export DEB_SAFESESSION_LIB=/usr/lib/postgresql/16/lib/
export SAFESESSION_STRIPPED_LIB=pgedge_safesession.so

# PostgreSQL extensions
export SAFESESSION_EXTENSIONS=pgedge_safesession

# Extension version as reported by \dx (the .control file's default_version).
# Tracked separately from the package version, which they need not match.
export SAFESESSION_EXTENSION_VERSION=1.0

# SBOM basename (shipped under the PG tree's sbom/ directory)
export SAFESESSION_SBOM=pgedge-safesession-sbom.json

# Package version — 1.0 GA on both platforms.
export PGEDGE_SAFESESSION_16_VERSION=1.0

# ============================================================
# Configuration parameters for pgmq
# ============================================================

# Package name(s) — coupled component (tied to the PG major version)
export PGMQ_PACKAGE=pgedge-pgmq_16
export DEB_PGMQ_PACKAGE=pgedge-postgresql-16-pgmq

# PostgreSQL extensions. pgmq is a pure SQL extension — it ships no standalone
# binary and no shared library, so it needs no shared_preload_libraries entry.
export PGMQ_EXTENSIONS=pgmq

# Extension version as reported by \dx (the .control file's default_version).
# Tracked separately from the package version, which they need not match.
export PGMQ_EXTENSION_VERSION=1.12.0

# SBOM basename (shipped under the PG tree's sbom/ directory)
export PGMQ_SBOM=pgmq-sbom.json

# Package version
export PGEDGE_PGMQ_16_VERSION=1.12.0
