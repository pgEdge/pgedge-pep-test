export PGADMIN_SBOM=/usr/pgadmin4/
export DECOUPLED_COMPONENTS_SBOM=/usr/share

# ============================================================
# Configuration parameters for AI DB Workbench
# ============================================================

# Package names
export AI_DBA_SERVER_PACKAGE=pgedge-ai-dba-server
export AI_DBA_ALERTER_PACKAGE=pgedge-ai-dba-alerter
export AI_DBA_COLLECTOR_PACKAGE=pgedge-ai-dba-collector
export AI_DBA_CLIENT_PACKAGE=pgedge-ai-dba-client
export AI_DBA_COMPONENTS=pgedge-ai-dba-server,pgedge-ai-dba-alerter,pgedge-ai-dba-collector,pgedge-ai-dba-client

# Binaries
export AI_DBA_ALERTER_BINARY=/usr/bin/ai-dba-alerter
export AI_DBA_COLLECTOR_BINARY=/usr/bin/ai-dba-collector
export AI_DBA_SERVER_BINARY=/usr/bin/ai-dba-server

# Package version
export PGEDGE_AI_DBA_VERSION=1.0.0
# ============================================================
# Configuration parameters for Radar
# ============================================================

# Package name(s)
export RADAR_PACKAGE=pgedge-radar

# Binary path
export RADAR_BINARY=/usr/bin/radar
export COMPONENT_BINARY=/usr/bin/radar

# Package version
export PGEDGE_RADAR_VERSION=0.4.1

# ============================================================
# Configuration parameters for LLVM JIT
# ============================================================

# Package name(s)
export LLVMJIT_PACKAGE=pgedge-postgresql18-llvmjit
export DEB_LLVMJIT_PACKAGE=pgedge-postgresql18-llvmjit

# ============================================================
# Configuration parameters for Supautils
# ============================================================

# Package name(s)
export SUPAUTILS_PACKAGE=pgedge-supautils_18
export DEB_SUPAUTILS_PACKAGE=pgedge-postgresql-18-supautils

# Package version
export PGEDGE_SUPAUTILS_VERSION=3.2.2
# Configuration parameters for AI KB
# ============================================================

# Package names (same for RHEL and DEB — decoupled)
export AI_KB_GEMINI_PACKAGE=pgedge-ai-kb-gemini-gemini-embedding-001
export AI_KB_OLLAMA_PACKAGE=pgedge-ai-kb-ollama-nomic-embed-text
export AI_KB_OPENAI_PACKAGE=pgedge-ai-kb-openai-text-embedding-3-small
export AI_KB_VOYAGE_PACKAGE=pgedge-ai-kb-voyage-voyage-3
export AI_KB_COMPONENTS=pgedge-ai-kb-gemini-gemini-embedding-001,pgedge-ai-kb-ollama-nomic-embed-text,pgedge-ai-kb-openai-text-embedding-3-small,pgedge-ai-kb-voyage-voyage-3

# Package version
export PGEDGE_AI_KB_VERSION=1.0.1

# ============================================================
# Configuration parameters for Pgvector
# ============================================================

# Package name(s) — coupled component (tied to PG major version)
export PGVECTOR_PACKAGE=pgedge-pgvector_18
export DEB_PGVECTOR_PACKAGE=pgedge-postgresql-18-pgvector

# PostgreSQL extensions
export PGVECTOR_EXTENSIONS=vector

# Package version is defined above as PGEDGE_PGVECTOR_18_VERSION
