# Container details (comma separated if multiple)

#CONTAINERS=auto-rocky9-arm,auto-alma10-arm,auto-alma9-amd,auto-oel9-amd,auto-alma9-arm,auto-oel9-arm
#CONTAINERS=auto-oel9-amd
DEB-CONTAINERS=auto-debian11,auto-debian12-arm,auto-debian13-arm,auto-ubuntu2204-arm,auto-ubuntu2404-arm
#DEB-CONTAINERS=auto-debian13-arm

#ubuntu-systemd-custom
# Component versions
PG_VERSION=16.10
PG_MAJOR_VERSION=16
PGEDGE_SPOCK50_16_VERSION=5.0.4
PGEDGE_LOLOR_16_VERSION=1.2.1
PGEDGE_SNOWFLAKE_16_VERSION=2.2
PGEDGE_PGAUDIT_16_VERSION=16.10
PGEDGE_PGVECTOR_16_VERSION=0.8.1
PGEDGE_POSTGIS35_16_VERSION=3.5.3
PGEDGE_ENTERPRISE_ALL_16_VERSION=16.10
PGEDGE_ENTERPRISE_POSTGRES_16_VERSION=16.10
PGEDGE_PLDEBUGGER_16_VERSION=1.9
PGEDGE_POSTGRESQL16_SERVER_VERSION=16.10
PGEDGE_POSTGRESQL16_PLPERL_VERSION=16.10
PGEDGE_POSTGRESQL16_PLTCL_VERSION=16.10
PGEDGE_POSTGRESQL16_PLPYTHON3_VERSION=16.10



# Repository (release | staging | daily)
REPO=staging

# Components (comma separated)
COMPONENTS=pgedge-postgresql16-server,pgedge-lolor_16,pgedge-snowflake_16
SERVER_COMPONENTS=pgedge-lolor_16,pgedge-spock50_16,pgedge-snowflake_16,pgedge-pgaudit_16,pgedge-pgvector_16,pgedge-postgis35_16,pgedge-enterprise-all_16,pgedge-enterprise-postgres_16,pgedge-postgresql16-server,pgedge-postgresql16-contrib,pgedge-pldebugger_16,pgedge-postgresql16-plperl,pgedge-postgresql16-pltcl,pgedge-postgresql16-plperl,pgedge-postgresql16-plpython3
#SERVER_COMPONENTS=pgedge-lolor_16,pgedge-spock50_16,pgedge-snowflake_16,pgedge-pgaudit_16,pgedge-pgvector_16,pgedge-enterprise-postgres_16,pgedge-postgresql16-server,pgedge-postgresql16-contrib,pgedge-pldebugger_16,pgedge-postgresql16-plperl,pgedge-postgresql16-pltcl,pgedge-postgresql16-plperl,pgedge-postgresql16-plpython3
# Components name for Ubuntu and Debian packages (comma seperated)
DEB_SERVER_COMPONENTS=pgedge-enterprise-postgres-16,pgedge-postgresql-16,pgedge-postgresql,pgedge-postgresql-plperl-16,pgedge-postgresql-plpython3-16,pgedge-postgresql-pltcl-16,pgedge-postgresql-16-pldebugger
DEB_COMPONENTS=pgedge-postgresql-all,pgedge-postgresql-16-pldebugger,pgedge-enterprise-all-16
# Whether to test extensions
TEST_EXTENSIONS=true
# Base extensions (contrib + builtins)
### All extensions
EXTENSIONS=snowflake,spock,lolor,pldbgapi,vector,bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp,postgis,postgis_topology,postgis_raster,postgis_sfcgal,fuzzystrmatch,postgis_tiger_geocoder,address_standardizer,address_standardizer_data_us
#EXTENSIONS=snowflake,spock,lolor,pldbgapi,vector,bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp
## only server extensions
#EXTENSIONS=bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp

# PL packages (comma separated)
PL_PACKAGES=pgedge-postgresql16-plperl,pgedge-postgresql16-pltcl,pgedge-postgresql16-plpython3

# PL extensions (comma separated)
PL_EXTENSIONS=plperl,pltcl,plpython3u

# Cluster configuration
PG_USER=postgres
PG_PORT=5432
## PG BIN for RHEL
PG_BIN_PATH=/usr/pgsql-16/bin
## PG BIN for DEB
DEB_PG_BIN_PATH=/usr/lib/postgresql/16/bin/
PG_DATA_DIR=/tmp/n1


