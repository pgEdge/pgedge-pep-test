export DEB_CONTAINERS=auto-debian11

#ubuntu-systemd-custom
# Component versions
export PG_VERSION=17.7
export PG_MAJOR_VERSION=17
export PGEDGE_SPOCK50_17_VERSION=5.0.4
export PGEDGE_LOLOR_17_VERSION=1.2.2
export PGEDGE_SNOWFLAKE_17_VERSION=2.4
export PGEDGE_PGAUDIT_17_VERSION=17.1
export PGEDGE_PGVECTOR_17_VERSION=0.8.1
export PGEDGE_POSTGIS35_17_VERSION=3.5.3
export PGEDGE_ENTERPRISE_ALL_17_VERSION=17.7
export PGEDGE_ENTERPRISE_POSTGRES_17_VERSION=17.7
export PGEDGE_PLDEBUGGER_17_VERSION=1.9
export PGEDGE_POSTGRESQL17_SERVER_VERSION=17.7
export PGEDGE_POSTGRESQL17_PLPERL_VERSION=17.7
export PGEDGE_POSTGRESQL17_PLTCL_VERSION=17.7
export PGEDGE_POSTGRESQL17_PLPYTHON3_VERSION=17.7
export PGEDGE_PGBOUNCER_VERSION=1.25.0
export PGEDGE_PGBACKREST_VERSION=2.56.0
export PGEDGE_PGADMIN4_VERSION=9.8



# Repository (release | staging | daily)
export REPO=release
export UPGRADE=false # Possible values true | false
export UPGRADE_REPO=staging

# Configuration paratmers for pgbouncer
export PGBOUNCER_PACKAGE=pgedge-pgbouncer
export PGBOUNCER_PORT=6432
export PGBOUNCER_CONFIG_DIR=/etc/pgbouncer
export PGBOUNCER_USER=pgbouncer
export DEB_PGBOUNCER_BIN=/usr/sbin



# Configuration paratmers for SnowFlake
export SNOWFLAKE_PACKAGE=pgedge-snowflake_17
export DEB_SNOWFLAKE_PACKAGE=pgedge-postgresql-17-snowflake
export SNOWFLAKE_NODE=1

# RHEL Components (comma separated)
export SERVER_COMPONENTS=pgedge-lolor_17
#export SERVER_COMPONENTS=pgedge-enterprise-all_17,pgedge-pldebugger_17,pgedge-*17*llvm*
#export SERVER_COMPONENTS=pgedge-lolor_17,pgedge-spock50_17,pgedge-snowflake_17,pgedge-pgaudit_17,pgedge-pldebugger_17
#export SERVER_COMPONENTS=pgedge-lolor_17,pgedge-spock50_17,pgedge-snowflake_17,pgedge-pgaudit_17,pgedge-pgvector_17,pgedge-postgis35_17,pgedge-postgresql17-server,pgedge-postgresql17-contrib,pgedge-pldebugger_17,pgedge-pgbouncer,pgedge-pgbackrest,pgedge-pgadmin4
#export SERVER_COMPONENTS=pgedge-enterprise-all_17,pgedge-enterprise-postgres_17,pgedge-postgresql17-server,pgedge-postgresql17-contrib,pgedge-pldebugger_17

# Components name for Ubuntu and Debian packages (comma seperated)
#export DEB_SERVER_COMPONENTS=pgedge-postgresql-17-pldebugger,pgedge-postgresql-17-pgaudit,pgedge-postgresql-17-lolor,pgedge-postgresql-17-snowflake,pgedge-postgresql-17-spock50,
#export DEB_SERVER_COMPONENTS=pgedge-postgresql-17,pgedge-postgresql,pgedge-postgresql-plperl-17,pgedge-postgresql-plpython3-17,pgedge-postgresql-pltcl-17,pgedge-postgresql-17-pldebugger,pgedge-postgresql-17-postgis-3,pgedge-postgresql-17-pgvector,pgedge-postgresql-17-pgaudit,pgedge-postgresql-17-lolor,pgedge-postgresql-17-snowflake,pgedge-postgresql-17-spock50,pgedge-pgbackrest,pgedge-pgadmin4,pgedge-pgbouncer
