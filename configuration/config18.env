# Configuration parameters for Zero Downtime Integration Testing
export ENTERPRISE_ALL_PACKAGE=pgedge-enterprise-postgres_18
export DEB_ENTERPRISE_ALL_PACKAGE=pgedge-enterprise-postgres-18
export ALL_META_PACKAGE=pgedge-enterprise-postgres_18
export LATEST_ZODAN_PY=zodan-505.py
export ZODAN_EXECUTION=sql # Possible values sql | py
export LATEST_ZODAN_SQL=zodan-510.sql
# Spock-major-specific zodan cross-wiring scripts (failover test picks by SPOCK_MAJOR).
# spock60 renamed catalog columns (remote_lsn -> remote_commit_lsn) and needs zodan-600.sql.
export LATEST_ZODAN_SQL_SPOCK50=zodan-510.sql
export LATEST_ZODAN_SQL_SPOCK60=zodan-600.sql
export NO_OF_NODES=2
export BASE_PORT=6431

# Configuration parameters for Spock-Patroni Failover Testing
# Nodes: n1 (standalone Spock, port BASE_PORT), n2 (Patroni primary, port BASE_PORT+1)
# Standby: r1 (Patroni physical replica of n2, port PATRONI_STANDBY_PORT)
export PATRONI_FAILOVER_NO_OF_NODES=2
export PATRONI_FAILOVER_BASE_PORT=5432
export PATRONI_STANDBY_PORT=6432
export PATRONI_SCOPE=zone-n2
export PATRONI_N2_RESTAPI_PORT=8008
export PATRONI_R1_RESTAPI_PORT=8009
export PATRONI_ETCD_HOST=localhost:2379

