# Container details (comma separated if multiple)

#CONTAINERS=auto-rocky9-arm,auto-alma10-arm,auto-alma9-amd,auto-oel9-amd,auto-alma9-arm,auto-oel9-arm
#CONTAINERS=auto-oel9-amd
DEB-CONTAINERS=auto-debian11,auto-debian12-arm,auto-debian13-arm,auto-ubuntu2404-arm,auto-ubuntu2404-arm
#CONTAINERS=auto-ubuntu2204-arm,auto-ubuntu2404-arm

#ubuntu-systemd-custom
# Component versions
PG_VERSION=18.0
PG_MAJOR_VERSION=18

# Repository (release | staging | daily)
REPO=staging

# Components (comma separated)
COMPONENTS=pgedge-postgresql18-server,pgedge-lolor_18,pgedge-snowflake_18
SERVER_COMPONENTS=pgedge-lolor_18,pgedge-spock50_18,pgedge-snowflake_18,pgedge-pgaudit_18,pgedge-pgvector_18,pgedge-postgis35_18,pgedge-enterprise-all_18,pgedge-enterprise-postgres_18,pgedge-postgresql18-server,pgedge-postgresql18-contrib,pgedge-pldebugger_18
# Components name for Ubuntu and Debian packages (comma seperated)
DEB_SERVER_COMPONENTS=pgedge-enterprise-postgres-18,pgedge-postgresql-18,pgedge-postgresql,pgedge-postgresql-plperl-18,pgedge-postgresql-plpython3-18,pgedge-postgresql-pltcl-18,pgedge-postgresql-18-pldebugger
DEB_COMPONENTS=pgedge-postgresql-all,pgedge-postgresql-18-pldebugger,pgedge-enterprise-all-18
# Whether to test extensions
TEST_EXTENSIONS=true
# Base extensions (contrib + builtins)
### All extensions
EXTENSIONS=postgis,snowflake,spock,lolor,pldbgapi,vector,bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp
## only server extensions
#EXTENSIONS=bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp

# PL packages (comma separated)
PL_PACKAGES=pgedge-postgresql18-plperl,pgedge-postgresql18-pltcl,pgedge-postgresql18-plpython3

# PL extensions (comma separated)
PL_EXTENSIONS=plperl,pltcl,plpython3u

# Cluster configuration
PG_USER=postgres
PG_PORT=5432


PG_BIN_PATH=/usr/lib/postgresql/18/bin/
PG_DATA_DIR=/tmp/n1


