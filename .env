# Container details (comma separated if multiple)
# =================
#export CONTAINERS=auto-rocky9-arm,auto-alma10-arm,auto-alma9-amd,auto-oel9-amd,auto-alma9-arm,auto-oel9-arm
export CONTAINERS=auto-rocky9-arm
#export DEB_CONTAINERS=auto-debian11,auto-debian12-arm,auto-debian13-arm,auto-ubuntu2404-arm,auto-ubuntu2404-arm
export DEB_CONTAINERS=auto-debian11

# AWS running instance details (comma separated if multiple)
# =================
INSTANCES=ec2-65-0-18-65.ap-south-1.compute.amazonaws.com,ec2-52-66-252-105.ap-south-1.compute.amazonaws.com
USERNAMES=rocky
KEY_PATHS=keys/zaid_key_official.pem

#ubuntu-systemd-custom
# Component versions
# =================
export PG_VERSION=18.0
export PG_MAJOR_VERSION=18
export PGEDGE_SPOCK50_18_VERSION=5.0.4
export PGEDGE_LOLOR_18_VERSION=1.2.1
export PGEDGE_SNOWFLAKE_18_VERSION=2.2
export PGEDGE_PGAUDIT_18_VERSION=18.0
export PGEDGE_PGVECTOR_18_VERSION=0.8.1
export PGEDGE_POSTGIS35_18_VERSION=3.5.3
export PGEDGE_ENTERPRISE_ALL_18_VERSION=18.0
export PGEDGE_ENTERPRISE_POSTGRES_18_VERSION=18.0
export PGEDGE_PLDEBUGGER_18_VERSION=1.9
export PGEDGE_POSTGRESQL18_SERVER_VERSION=18.0
export PGEDGE_POSTGRESQL18_PLPERL_VERSION=18.0
export PGEDGE_POSTGRESQL18_PLTCL_VERSION=18.0
export PGEDGE_POSTGRESQL18_PLPYTHON3_VERSION=18.0
export PGEDGE_PGBOUNCER_VERSION=1.24.1
export PGEDGE_PGBACKREST_VERSION=2.56.0
export PGEDGE_PGADMIN4_VERSION=9.8

# Repository (release | staging | daily)
export REPO=staging
export UPGRADE=true # Possible values true | false
export UPGRADE_REPO=staging


# RHEL Components (comma separated)
#export SERVER_COMPONENTS=pgedge-lolor_18,pgedge-spock50_18,pgedge-snowflake_18,pgedge-pgaudit_18,pgedge-pldebugger_18
export SERVER_COMPONENTS=pgedge-lolor_18,pgedge-spock50_18,pgedge-snowflake_18,pgedge-pgaudit_18,pgedge-pgvector_18,pgedge-postgis35_18,pgedge-postgresql18-server,pgedge-postgresql18-contrib,pgedge-pldebugger_18,pgedge-pgbouncer,pgedge-pgbackrest,pgedge-pgadmin4
# export SERVER_COMPONENTS=pgedge-enterprise-all_18,pgedge-enterprise-postgres_18,pgedge-postgresql18-server,pgedge-postgresql18-contrib,pgedge-pldebugger_18

# Components name for Ubuntu and Debian packages (comma seperated)
#export DEB_SERVER_COMPONENTS=pgedge-postgresql-18-pldebugger,pgedge-postgresql-18-pgaudit,pgedge-postgresql-18-lolor,pgedge-postgresql-18-snowflake,pgedge-postgresql-18-spock50
export DEB_SERVER_COMPONENTS=pgedge-postgresql-18,pgedge-postgresql,pgedge-postgresql-plperl-18,pgedge-postgresql-plpython3-18,pgedge-postgresql-pltcl-18,pgedge-postgresql-18-pldebugger,pgedge-postgresql-18-postgis-3,pgedge-postgresql-18-pgvector,pgedge-postgresql-18-pgaudit,pgedge-postgresql-18-lolor,pgedge-postgresql-18-snowflake,pgedge-postgresql-18-spock50,pgedge-pgbackrest,pgedge-pgadmin4,pgedge-pgbouncer
# export DEB_SERVER_COMPONENTS=pgedge-enterprise-all-18,pgedge-postgresql-plperl-18,pgedge-postgresql-plpython3-18,pgedge-postgresql-pltcl-18,pgedge-postgresql-18-pldebugger

# Whether to test extensions
export TEST_EXTENSIONS=true
# Base extensions (contrib + builtins)
### All extensions
export EXTENSIONS=postgis,snowflake,spock,lolor,pldbgapi,vector,bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp
## only server extensions
#EXTENSIONS=bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp

# PL packages (comma separated)
export PL_PACKAGES=pgedge-postgresql18-plperl,pgedge-postgresql18-pltcl,pgedge-postgresql18-plpython3

# PL extensions (comma separated)
export PL_EXTENSIONS=plperl,pltcl,plpython3u

# Cluster configuration
export PG_USER=postgres
export PG_PORT=5432

## PG BIN for RHEL
export PG_BIN_PATH=/usr/pgsql-18/bin
## PG BIN for DEB
export DEB_PG_BIN_PATH=/usr/lib/postgresql/18/bin/
export PG_DATA_DIR=/tmp/n1