## only server extensions
#export EXTENSIONS=bloom,bool_plperl,btree_gin,btree_gist,citext,cube,dblink,dict_int,earthdistance,fuzzystrmatch,hstore,intagg,intarray,isn,jsonb_plperl,lo,ltree,pg_buffercache,pg_prewarm,pg_stat_statements,pg_trgm,pgcrypto,pgrowlocks,pgstattuple,plperl,plpgsql,postgres_fdw,seg,sslinfo,tablefunc,tsm_system_rows,tsm_system_time,unaccent,uuid-ossp

# PL packages (comma separated)
export PL_PACKAGES=pgedge-postgresql17-plperl,pgedge-postgresql17-pltcl,pgedge-postgresql17-plpython3

# PL extensions (comma separated)
export PL_EXTENSIONS=plperl,pltcl,plpython3u

# Cluster configuration
export PG_USER=postgres
export PG_PORT=5432
## PG BIN for RHEL
export PG_BIN_PATH=/usr/pgsql-17/bin
## PG BIN for DEB
export DEB_PG_BIN_PATH=/usr/lib/postgresql/17/bin/
export DEB_PG_PATH=/usr/lib/postgresql/17/
export DEB_PG_SHARE_PATH=/usr/share/postgresql/17/
export PG_DATA_DIR=/tmp/n1


