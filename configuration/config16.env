# ============================================================
# Configuration parameters for Control Plane
# ============================================================

# Package name(s) — decoupled component (RHEL and DEB names identical)
export CONTROL_PLANE_PACKAGE=pgedge-control-plane

# Binary path (component-specific; the generic COMPONENT_BINARY is shared
# last-wins across sections, so control-plane uses its own var)
export CONTROL_PLANE_BINARY=/usr/sbin/pgedge-control-plane
