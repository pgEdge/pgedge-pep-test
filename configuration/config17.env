#export CONTAINERS=auto-rocky10-arm,auto-alma9-arm,auto-alma10-arm,auto-oel9-arm,auto-oel10-arm,my-rocky9-amd,auto-alma9-amd,auto-oel9-amd
export CONTAINERS=auto-rocky9-arm
